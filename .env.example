# wenku8 登录后从浏览器请求头复制的整行 Cookie（必须）
WENKU_COOKIES=

# 仅 steel 模式需要；playwright 模式可留空
STEEL_API_KEY=

# steel / playwright / requests（推荐 steel）
SCRAPER=steel

# 6 小时 = 21600 秒
RUN_INTERVAL_SECONDS=21600

# Compose CPU 配额；0.70 表示最多使用单核的 70%
WENKU8_CPU_LIMIT=0.70

# 超时保护：整轮抓取、蓝奏下载子进程、单条蓝奏任务
SCRAPE_TIMEOUT_SECONDS=1800
LANZOU_RUN_TIMEOUT_SECONDS=600
LANZOU_ENTRY_TIMEOUT_SECONDS=360

# 是否自动下载并提取蓝奏 EPUB（true/false）
ENABLE_LANZOU_DOWNLOAD=true

# 是否自动上传蓝奏 EPUB 到 OneDrive，并在确认成功后删除本地文件（true/false）
ENABLE_ONEDRIVE_UPLOAD=false

# OneDrive 目标目录（rclone remote:path 格式）
ONEDRIVE_REMOTE_TARGET=wenku8_od:轻小说/wenku8

# OneDrive 根目录，用于清理历史误传到根目录的平铺 EPUB；留空则自动取 TARGET 的上级目录
ONEDRIVE_REMOTE_ROOT=wenku8_od:轻小说

# 上传/清理轮询间隔（秒）
ONEDRIVE_UPLOAD_INTERVAL_SECONDS=120

# 是否清理 OneDrive 根目录下已在 wenku8 目录中存在的重复 EPUB（true/false）
ONEDRIVE_CLEAN_REMOTE_ROOT_DUPLICATES=true
